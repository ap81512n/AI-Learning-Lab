
# Example non-secret configuration
FDE_ENTRYPOINT=scripts/run_async_fetch.py
FDE_ENV=development


# Docker Compose local development
POSTGRES_DB=fde_lab
POSTGRES_USER=fde_user
POSTGRES_PASSWORD=replace-with-a-local-development-password


OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini
LLM_INPUT_USD_PER_1M=put-your-input-cost-here
LLM_OUTPUT_USD_PER_1M=put-your-output-cost-here